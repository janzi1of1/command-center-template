# Your own Supabase project — Settings → API.
# There is no fallback for these on purpose: without them the app refuses to
# start, rather than quietly connecting to somebody else's Command Center.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Same values, for the server functions.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Only needed for the optional voice assistant. Leave blank and that panel
# stays quiet; everything else works.
OPENAI_API_KEY=
