# The bridge between the COMMS panel and your AI assistants.
# Copy this to .env in the same folder. Never commit .env.

# Your Supabase project.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The SERVICE key — Settings → API → service_role. NOT the publishable one.
# Rows are row-level-secured to the account that wrote them, and this process
# is not signed in as anybody, so it needs to read across the table.
# This key bypasses row level security. Keep it on your machine only.
SUPABASE_SERVICE_KEY=your-service-role-key

# Your own user id, so messages the assistants send are owned by you and show
# up in your panel. Get it by signing in and running, in the SQL editor:
#   select id, email from auth.users;
COMMAND_CENTER_USER_ID=

# Where the inbox files get written. Point this at the folder your assistant
# actually works out of. Leave blank to write them next to these scripts.
INBOX_DIR=

POLL_SECONDS=10
